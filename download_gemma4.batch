#!/bin/bash -l
#SBATCH --mail-type=ALL
#SBATCH --mail-user=simeon.serafimov@student.kuleuven.be
#SBATCH --clusters=genius
#SBATCH --account=lp_dtaikg
#SBATCH --partition=gpu_v100_long
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --gpus-per-node=1
#SBATCH --time=24:00:00
#SBATCH --job-name=download_gemma4
